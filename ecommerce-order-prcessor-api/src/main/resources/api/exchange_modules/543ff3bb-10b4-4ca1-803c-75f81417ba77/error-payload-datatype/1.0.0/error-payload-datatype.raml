#%RAML 1.0 DataType
type: object
description: Standard Process API error response.
properties: 
  code: 
    type: integer
    required: true
    example: 400

  message: 
    type: string 
    required: true 
    example: "INSUFFICIENT_STOCK"

  description: 
    type: string 
    required: true 
    example: "Insufficient stock for product PROD-002" 

  correlationId: 
    type: string 
    required: true 
    example: "7e4c9e11-3f12-4a89-9a81-28d1c7f0b5d2" 

  dateTime: 
    type: datetime 
    required: true 
    example: "2026-09-28T15:20:00Z"