<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<error-handler name="global-errors-handler" doc:id="2b3c5113-d3f8-4e9b-b1e1-2a5121d268ca" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="1a93ec86-9969-407e-90af-9dd41d821a6f" type="APIKIT:BAD_REQUEST" >
			<set-variable value="400" doc:name="Set HTTP status - 400" doc:id="4164a9e5-7c14-44d3-96a1-a082c0e934e6" variableName="httpStatus" />
			<flow-ref doc:name="Flow Reference" doc:id="89445be2-2403-4aa7-aace-da32467032a1" name="prepare-error-payload" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="20ffa49e-a94f-48e6-a639-6fc135739dfb" type="APIKIT:NOT_FOUND" >
			<set-variable value="404" doc:name="Set HTTP Status - 404" doc:id="98ce928e-2a75-45d8-af14-4c3dd16a6283" variableName="httpStatus" />
			<set-variable value='#["Resource Not Found"]' doc:name="Set Error Message" doc:id="d9ca1a2e-b5b5-4a35-a758-cc8acdebe74b" variableName="message" />
			<set-variable value='#["The server has not found  the provided resource identifier"]' doc:name="Set Error Description" doc:id="df2ce4d8-ce53-4f75-b32b-f18df3109209" variableName="description" />
			<flow-ref doc:name="Flow Reference" doc:id="0c38d5f2-1c38-43b7-8884-d97b67acd056" name="prepare-error-payload" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="f60ba8c4-2266-4a41-b3b9-6003d022e843" type="APIKIT:METHOD_NOT_ALLOWED" >
			<set-variable value="405" doc:name="Set HTTP Status - 405" doc:id="b613b4af-4705-4edd-a15d-60f59176e0f3" variableName="httpStatus" />
			<set-variable value='#["Method Not Allowed"]' doc:name="Set Error Message" doc:id="47732582-0058-46c9-a16d-1c85e4c7f371" variableName="message" />
			<set-variable value='#["The method specified in the request is not allowed&#10;for this resource"]' doc:name="Set Error Description" doc:id="e624e60d-549f-40a4-b80f-5f0e55100d0a" variableName="description" />
			<flow-ref doc:name="Flow Reference" doc:id="667ae289-7b2c-4d52-9561-0f1a4400aa02" name="prepare-error-payload" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="5461495b-18ba-43c8-aa3b-6289ec7a5f68" type="APIKIT:NOT_ACCEPTABLE" >
			<set-variable value="406" doc:name="Set HTTP Status -406" doc:id="1d1402a0-1a2e-406d-abd6-0dce2533b012" variableName="httpStatus" />
			<set-variable value='#[" Not Acceptable"]' doc:name="Set Error Message " doc:id="ed341f45-f8f8-4279-9f16-1e22573c7656" variableName="message" />
			<set-variable value='#["The resource identified by the request is not&#10;capable of generating response entities according to the request&#10;accept headers"]' doc:name="Set Error Description" doc:id="ec312e41-b024-420f-87f2-f5e108ac3d40" variableName="description" />
			<flow-ref doc:name="Flow Reference" doc:id="ac753ed8-aa1e-428d-8103-ced4aea67002" name="prepare-error-payload" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="737ad015-f5e9-4595-a414-98210611ecfe" type="APIKIT:UNSUPPORTED_MEDIA_TYPE" >
			<set-variable value="415" doc:name="Set HTTP Status - 415" doc:id="dcfda039-d74f-4188-be1a-67f661aab156" variableName="httpStatus" />
			<set-variable value='#["Unsupported media type"]' doc:name="Set Error Message" doc:id="6bbee851-196f-41d7-a62f-1b22a527587f" variableName="message" />
			<set-variable value='#["The server is refusing to service the request&#10;because the entity of the request is in a format not supported by&#10;the requested resource for the requested method"]' doc:name="Set Error Description" doc:id="4bcc24ba-1c3b-45e5-8a28-ceb278b73e55" variableName="description" />
			<flow-ref doc:name="Flow Reference" doc:id="fbac61c7-5f3d-4741-9054-1c615c2187c6" name="prepare-error-payload" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="480df7c2-2a35-4c77-971d-0708cac1e429" type="ANY" >
			<set-variable value="#[if (error.errorMessage.payload.code?)&#10;	error.errorMessage.payload.code as Number&#10;else&#10;	500]" doc:name="Set HTTP Status" doc:id="7864b74e-bc45-46ef-a765-83e47567be73" variableName="httpStatus" />
			<ee:transform doc:name="Set Error Payload" doc:id="2d041a6a-452a-4859-8250-227551732344" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
if (error.errorMessage.payload.code?)
	error.errorMessage.payload
else
  {
	code: vars.httpStatus,
	message: vars.message default "Internal Server Error",
	description: vars.description default "An unexpected error occurs on the server. Please contact the support team",
	dateTime: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"},
	"correlationId": vars.correlationId default attributes.headers.'x-correlation-id'
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
		</on-error-propagate>
	</error-handler>
	<sub-flow name="prepare-error-payload" doc:id="23c294d3-bb11-4975-a065-9d7903268995" >
		<ee:transform doc:name="Transform Message" doc:id="d387843a-2c0e-49b0-8124-550e2e0f4920" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	code: vars.httpStatus,
	message: vars.message default error.errorType.identifier,
	description: vars.description default error.description,
	dateTime: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"},
	"correlationId": vars.correlationId default attributes.headers.'x-correlation-id',
}]]></ee:set-payload>
			</ee:message>
			<ee:variables />
		</ee:transform>
	</sub-flow>
</mule>
