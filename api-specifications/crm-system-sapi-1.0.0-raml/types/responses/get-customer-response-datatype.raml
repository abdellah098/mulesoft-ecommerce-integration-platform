#%RAML 1.0 DataType
type: 
  xml:
    name: customer
  properties:
    id:
      type: string
      required: true
    name:
      type: string
      required: true
    status:
      type: string
      required: true
      enum:
        - ACTIVE
        - PAUSED
        - DELETED
    isPartner:
      type: boolean
      required: true
    email: 
      type: string
      required: true
      pattern: "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    phone:
      type: string