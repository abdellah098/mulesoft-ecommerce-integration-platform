#%RAML 1.0 Library

types:
  OrderItem:
    type: object
    description: Product line included in an order.
    properties:
      productId:
        type: string
        required: true
        pattern: "^PROD-[0-9]{1,6}$"
        example: "PROD-1003"

      quantity:
        type: integer
        required: true
        minimum: 1
        example: 3

      unitPrice:
        type: number
        required: true
        example: 10.99

  CreateOrderRequest:
    type: object
    description: Request used to initiate the order creation process.
    properties:
      orderId:
        type: string
        required: true
        pattern: "^ORD-[0-9]{1,6}$"
        example: "ORD-10023"

      customerId:
        type: string
        required: true
        example: "9a3d5c7e-1b2f-4d6a-8e9c-0f1a2b3c4d5e"

      items:
        type: OrderItem[]
        required: true
        minItems: 1

      currency:
        type: string
        required: true
        enum:
          - EUR
          - USD

  CustomerSummary: 
    type: object 
    description: Customer information exposed to the e-commerce consumer.
    properties: 
      id:
        type: string 
        required: true
        example: "9a3d5c7e-1b2f-4d6a-8e9c-0f1a2b3c4d5e" 

      name: 
        type: string 
        required: true 
        example: "Marc Lefevre" 

      active: 
        type: boolean 
        required: true 
        example: true
  
  OrderDetailResponse:
    type: object
    description: Summary information about an order.
    properties:
      orderId:
        type: string
        required: true
        pattern: "^ORD-[0-9]{1,6}$"
        example: "ORD-1000"

      status:
        type: string
        required: true
        enum:
          - CREATED
          - SHIPPED
          - CANCELLED

      totalAmount:
        type: number
        required: true
      customer: 
        type: CustomerSummary
        required: true
        
      currency:
        type: string
        required: true
        enum:
          - EUR
          - USD

      items:
        type: array
        minItems: 1
        required: true
        items:
          type: object
          properties:
            productId:
              type: string
              required: true
              pattern: "^PROD-[0-9]{1,6}$"
              example: "PROD-1033"
            quantity:
              type: number
              required: true
              example: 4

            unitPrice:
              type: number
              required: true
              example: 19.99

            totalPrice: 
              type: number
              required: true
              example: 79.98
    
      createdAt:
        type: datetime
        required: true

      updatedAt:
        type: datetime
        required: true
  
  CreateOrderResponse:
    type: object
    description: Result returned after the order has been successfully created.
    properties: 
      orderId: 
        type: string
        required: true
        example: "ORD-2026-000123"

      status: 
        type: string 
        required: true 
        enum: 
          - CREATED 
          - SHIPPED 
          - CANCELLED
        example: "CREATED"

      totalAmount:
        type: number
        format: double
        required: true
        example: 129.70

      message: 
        type: string
        required: false
        example: "Order created successfully"

  OrderCancelledResponse:
    type: object
    description: Result returned after an order has been cancelled.
    properties:
      orderId: 
        type: string
        required: true
        example: "ORD-2026-000123"

      status: 
        type: string 
        required: true 
        enum: 
          - CREATED 
          - SHIPPED 
          - CANCELLED
        example: "CREATED"
      
      message: 
        type: string
        required: false
        example: "Order created successfully"

