#%RAML 1.0 DataType

type: object
properties:

  productId:
    type: string
    required: true
    pattern: "^PROD-[0-9]{1,6}$"

  name:
    type: string
    required: true

  description:
    type: string
    required: false

  unitPrice:
    type: number
    required: true

  currency:
    type: string
    required: true
    enum: [EUR, USD]

  status:
    type: string
    required: true
    enum:
      - ACTIVE
      - INACTIVE
      - DISCONTINUED

  inventory:
    type: object
    required: true
    properties:

      availableQuantity:
        type: integer
        required: true

      reservedQuantity:
        type: integer
        required: true